# Pick whichever provider config.yaml's alert.provider is set to.

# Pushover (recommended — one-time paid iOS app, supports emergency priority)
# Create an app at https://pushover.net/apps/build to get a token.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ntfy.sh (free alternative)
# Pick a hard-to-guess topic name — anyone who knows it can post to your phone.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
